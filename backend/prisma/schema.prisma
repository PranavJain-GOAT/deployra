// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  DEVELOPER
  ADMIN
}

enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PurchaseStatus {
  COMPLETED
  REFUNDED
}

// ─── User ────────────────────────────────────────────────────────────────────
model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  password              String?
  googleId              String?   @unique
  name                  String
  firstName             String?
  lastName              String?
  country               String?   @default("India")
  role                  Role      @default(CLIENT)
  authProvider          String    @default("email")
  profileImage          String?
  lastLogin             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Email Verification
  isEmailVerified       Boolean   @default(false)
  emailVerifyToken      String?
  emailVerifyExpires    DateTime?

  // Password Reset
  resetPasswordToken    String?
  resetPasswordExpires  DateTime?

  // Brute-Force Protection
  failedLoginAttempts   Int       @default(0)
  lockedUntil           DateTime?

  // Payments (future Stripe Connect)
  stripeAccountId       String?

  // Two-Factor Authentication
  twoFactorSecret       String?
  twoFactorEnabled      Boolean   @default(false)
  twoFactorRecoveryCodes String?

  // Preferences & Privacy Settings
  preferencesJson       String?

  // Relations
  products        Product[]
  purchases       Purchase[]
  reviews         Review[]
  wishlists       Wishlist[]
  orders          Order[]
  notifications   Notification[]
  sentMessages    Message[]      @relation("SentMessages")
  recvMessages    Message[]      @relation("ReceivedMessages")
  refreshTokens   RefreshToken[]
  loginHistory    LoginHistory[]
  activities      Activity[]
}

// ─── Refresh Token Store ──────────────────────────────────────────────────────
// Stores hashed refresh tokens so individual sessions can be revoked.
model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique   // SHA-256 hash of the actual token
  userAgent   String?             // Browser/device identifier
  ipAddress   String?             // IP at time of login
  expiresAt   DateTime            // Hard expiry date
  revoked     Boolean   @default(false)
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Login History ────────────────────────────────────────────────────────────
// Immutable audit log of all login attempts.
model LoginHistory {
  id          String   @id @default(uuid())
  userId      String
  ipAddress   String?
  userAgent   String?
  success     Boolean
  failReason  String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Product ──────────────────────────────────────────────────────────────────
model Product {
  id               String        @id @default(uuid())
  title            String
  description      String
  price            Float
  developerId      String
  features         String[]
  images           String[]
  status           ProductStatus @default(PENDING)
  category         String?
  demoUrl          String?
  videoUrl         String?
  whatItDoes       String?
  whoItsFor        String[]
  whatsIncluded    String[]
  whatsNotIncluded String[]
  setupTime        String?
  deliveryDays     Int           @default(5)
  views            Int           @default(0)
  demoViews        Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  developer User       @relation(fields: [developerId], references: [id], onDelete: Cascade)
  purchases Purchase[]
  reviews   Review[]
  wishlists Wishlist[]
  orders    Order[]
}

// ─── Purchase ─────────────────────────────────────────────────────────────────
model Purchase {
  id              String         @id @default(uuid())
  userId          String
  productId       String
  pricePaid       Float
  paymentIntentId String?
  status          PurchaseStatus @default(COMPLETED)
  isInstalled     Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ─── Review ───────────────────────────────────────────────────────────────────
model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String?
  userId    String
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ─── Wishlist ─────────────────────────────────────────────────────────────────
model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// ─── Order ────────────────────────────────────────────────────────────────────
model Order {
  id        String   @id @default(uuid())
  userId    String
  productId String
  details   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ─── Message ──────────────────────────────────────────────────────────────────
model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
}

// ─── Notification ─────────────────────────────────────────────────────────────
model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Activity ─────────────────────────────────────────────────────────────────
model Activity {
  id        String   @id @default(uuid())
  userId    String
  type      String   // PRODUCT_PUBLISHED, PRODUCT_APPROVED, ORDER_CREATED, REVIEW_RECEIVED, etc.
  title     String
  body      String?
  meta      String?  // JSON blob for links/IDs
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
