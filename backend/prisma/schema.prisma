// This is your Prisma schema file for OmniPulse

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  critical
  high
  medium
  low
}

enum ItemStatus {
  pending
  done
  snoozed
  dismissed
}

enum ItemSource {
  email
  whatsapp
  codeforces
  leetcode
  codechef
  atcoder
  manual
}

enum ContestPlatform {
  codeforces
  leetcode
  codechef
  atcoder
  hackerrank
  hackerearth
}

model FeedItem {
  id             String     @id @default(uuid())
  title          String
  summary        String
  body           String?
  source         ItemSource
  priority       Priority   @default(medium)
  status         ItemStatus @default(pending)
  url            String?
  deadline       DateTime?
  extractedDates String[]
  tags           String[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  reminders Reminder[]
}

model Contest {
  id              String          @id @default(uuid())
  name            String
  platform        ContestPlatform
  url             String
  startTime       DateTime
  endTime         DateTime
  durationSeconds Int
  isRegistered    Boolean         @default(false)
  reminderSet     Boolean         @default(false)
  createdAt       DateTime        @default(now())
}

model Deadline {
  id           String     @id @default(uuid())
  title        String
  description  String?
  dueAt        DateTime
  source       ItemSource
  sourceItemId String?
  priority     Priority   @default(medium)
  status       ItemStatus @default(pending)
  tags         String[]
  createdAt    DateTime   @default(now())

  reminders Reminder[]
}

model Reminder {
  id               String     @id @default(uuid())
  feedItemId       String?
  deadlineId       String?
  fireAt           DateTime
  status           ItemStatus @default(pending)
  repeatUntilDone  Boolean    @default(true)
  channels         String[]   // ["browser", "sound", "telegram"]
  createdAt        DateTime   @default(now())

  feedItem FeedItem? @relation(fields: [feedItemId], references: [id])
  deadline Deadline? @relation(fields: [deadlineId], references: [id])
}

model Keyword {
  id        String   @id @default(uuid())
  word      String   @unique
  priority  Priority
  category  String
  createdAt DateTime @default(now())
}

model NotificationLog {
  id        String   @id @default(uuid())
  channel   String   // browser | sound | telegram
  title     String
  body      String?
  sentAt    DateTime @default(now())
  itemId    String?
}
